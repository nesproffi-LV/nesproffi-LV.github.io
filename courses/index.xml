  }

  
  document.addEventListener(&#39;click&#39;, function(e) {
    var link = e.target.closest ? e.target.closest(&#39;.lv-gallery__link&#39;) : null;
    if (link) {
      e.preventDefault();
      openLv(link.getAttribute(&#39;href&#39;));
      return;
    }
    if (e.target === overlay || e.target === close) {
      closeLv();
    }
  });
  document.addEventListener(&#39;keydown&#39;, function(e) {
    if (e.key === &#39;Escape&#39;) closeLv();
  });
})();
