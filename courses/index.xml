        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-4.webp&#34; alt=&#34;Динамичный скетч — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;figure class=&#34;lv-gallery__item lv-gallery__item--b2&#34;&gt;
      &lt;a href=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-5.webp&#34; class=&#34;lv-gallery__link&#34; data-lightbox&gt;
        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-5.webp&#34; alt=&#34;Динамичный скетч — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;figure class=&#34;lv-gallery__item lv-gallery__item--b3&#34;&gt;
      &lt;a href=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-6.webp&#34; class=&#34;lv-gallery__link&#34; data-lightbox&gt;
        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-6.webp&#34; alt=&#34;Динамичный скетч — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;/div&gt;
&lt;script&gt;
(function() {
  var links = document.querySelectorAll(&#39;.lv-gallery__link&#39;);
  if (!links.length) return;
  var overlay = document.createElement(&#39;div&#39;);
  overlay.className = &#39;lv-lightbox&#39;;
  overlay.innerHTML = &#39;&lt;button class=&#34;lv-lightbox__close&#34; aria-label=&#34;Закрыть&#34;&gt;&amp;times;&lt;/button&gt;&lt;img class=&#34;lv-lightbox__img&#34; alt=&#34;&#34;&gt;&#39;;
  document.body.appendChild(overlay);
  var img = overlay.querySelector(&#39;.lv-lightbox__img&#39;);
  var close = overlay.querySelector(&#39;.lv-lightbox__close&#39;);
  function openLv(src) {
    img.src = src;
    overlay.classList.add(&#39;lv-lightbox--open&#39;);
    document.body.style.overflow = &#39;hidden&#39;;
  }
  function closeLv() {
    overlay.classList.remove(&#39;lv-lightbox--open&#39;);
    document.body.style.overflow = &#39;&#39;;
    img.src = &#39;&#39;;
  }
  links.forEach(function(a) {
    a.addEventListener(&#39;click&#39;, function(e) {
      e.preventDefault();
      openLv(a.getAttribute(&#39;href&#39;));
    });
  });
  close.addEventListener(&#39;click&#39;, closeLv);
  overlay.addEventListener(&#39;click&#39;, function(e) { if (e.target === overlay) closeLv(); });
  document.addEventListener(&#39;keydown&#39;, function(e) { if (e.key === &#39;Escape&#39;) closeLv(); });
})();
&lt;/script&gt;

&lt;p&gt;Авторский курс из 7 занятий для тех, кто хочет рисовать людей и животных живо, точно и с характером — без лишней теории и долгих месяцев учёбы.&lt;/p&gt;</description>
