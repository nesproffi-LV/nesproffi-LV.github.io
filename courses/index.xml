        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/dynamic-sketch/sketch-3.webp&#34; alt=&#34;Динамичный скетч — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;figure class=&#34;lv-gallery__item lv-gallery__item--b1&#34;&gt;
