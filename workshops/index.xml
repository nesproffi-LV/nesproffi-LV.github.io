        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-2.webp&#34; alt=&#34;Картина за 3 часа — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;figure class=&#34;lv-gallery__item lv-gallery__item--2&#34;&gt;
      &lt;a href=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-3.webp&#34; class=&#34;lv-gallery__link&#34; data-lightbox&gt;
        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-3.webp&#34; alt=&#34;Картина за 3 часа — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;figure class=&#34;lv-gallery__item lv-gallery__item--3&#34;&gt;
      &lt;a href=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-4.webp&#34; class=&#34;lv-gallery__link&#34; data-lightbox&gt;
        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-4.webp&#34; alt=&#34;Картина за 3 часа — работы студии&#34; loading=&#34;lazy&#34;&gt;
