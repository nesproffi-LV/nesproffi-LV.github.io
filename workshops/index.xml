        &lt;img src=&#34;https://nesproffi-LV.github.io/images/gallery/mk-1/acrylic-6.webp&#34; alt=&#34;Картина за 3 часа — работы студии&#34; loading=&#34;lazy&#34;&gt;
      &lt;/a&gt;
    &lt;/figure&gt;&lt;/div&gt;
&lt;script&gt;
(function() {
  
  if (window.__lvLightboxInit) return;
  window.__lvLightboxInit = true;

  var overlay = document.createElement(&#39;div&#39;);
  overlay.className = &#39;lv-lightbox&#39;;
  overlay.innerHTML = &#39;&lt;button class=&#34;lv-lightbox__close&#34; aria-label=&#34;Закрыть&#34;&gt;&amp;times;&lt;/button&gt;&lt;img class=&#34;lv-lightbox__img&#34; alt=&#34;&#34;&gt;&#39;;
  document.body.appendChild(overlay);
  var img = overlay.querySelector(&#39;.lv-lightbox__img&#39;);
  var close = overlay.querySelector(&#39;.lv-lightbox__close&#39;);

  function openLv(src) {
    img.src = src;
    overlay.classList.add(&#39;lv-lightbox--open&#39;);
    document.body.style.overflow = &#39;hidden&#39;;
  }
  function closeLv() {
    overlay.classList.remove(&#39;lv-lightbox--open&#39;);
    document.body.style.overflow = &#39;&#39;;
    img.src = &#39;&#39;;
  }

  
  document.addEventListener(&#39;click&#39;, function(e) {
    var link = e.target.closest ? e.target.closest(&#39;.lv-gallery__link&#39;) : null;
    if (link) {
      e.preventDefault();
      openLv(link.getAttribute(&#39;href&#39;));
      return;
    }
    if (e.target === overlay || e.target === close) {
      closeLv();
    }
  });
  document.addEventListener(&#39;keydown&#39;, function(e) {
    if (e.key === &#39;Escape&#39;) closeLv();
  });
})();
&lt;/script&gt;

&lt;hr&gt;
&lt;h2 id=&#34;сюжеты-которые-мы-берём&#34;&gt;Сюжеты, которые мы берём&lt;/h2&gt;
&lt;p&gt;— величественные фьорды, где скалы встречаются с холодным морем;
— заснеженные вершины Гималаев, пронзающие облака;
— лавандовые поля Прованса, утопающие в фиолетовом тумане;
— северное сияние, танцующее над ледяными просторами;
— бирюзовые лагуны, где тёплый бриз шевелит пальмы.&lt;/p&gt;</description>
